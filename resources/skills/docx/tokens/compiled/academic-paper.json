{
  "genre": "academic-paper",
  "theme_name": "academic-paper",
  "theme_file": "../tokens/themes/academic-paper.json",
  "tokens": {
    "$name": "academic-paper",
    "$description": "中文学术论文主题。宋体与 Times New Roman 混排，三线表，严格编号体系，遵循 GB/T 7713 规范。",
    "typography": {
      "fontFamily": {
        "heading": {
          "$type": "fontFamily",
          "$value": "黑体, SimHei"
        },
        "body": {
          "$type": "fontFamily",
          "$value": "宋体, SimSun"
        },
        "bodyLatin": {
          "$type": "fontFamily",
          "$value": "Times New Roman, serif"
        },
        "caption": {
          "$type": "fontFamily",
          "$value": "宋体, SimSun"
        },
        "code": {
          "$type": "fontFamily",
          "$value": "Courier New, Consolas, monospace"
        }
      },
      "fontSize": {
        "title": {
          "$type": "dimension",
          "$value": "18pt",
          "$description": "论文标题（二号字）"
        },
        "h1": {
          "$type": "dimension",
          "$value": "15pt",
          "$description": "一级标题（三号黑体）"
        },
        "h2": {
          "$type": "dimension",
          "$value": "14pt",
          "$description": "二级标题（小三黑体）"
        },
        "h3": {
          "$type": "dimension",
          "$value": "12pt",
          "$description": "三级标题（四号黑体）"
        },
        "body": {
          "$type": "dimension",
          "$value": "12pt",
          "$description": "正文（四号宋体）"
        },
        "abstract": {
          "$type": "dimension",
          "$value": "11pt",
          "$description": "摘要（小四宋体）"
        },
        "caption": {
          "$type": "dimension",
          "$value": "10.5pt",
          "$description": "图表说明（五号）"
        },
        "footnote": {
          "$type": "dimension",
          "$value": "9pt",
          "$description": "脚注（小五）"
        }
      },
      "lineHeight": {
        "body": {
          "$type": "number",
          "$value": 1.5,
          "$description": "1.5 倍行距"
        },
        "abstract": {
          "$type": "number",
          "$value": 1.25
        },
        "heading": {
          "$type": "number",
          "$value": 1.5
        }
      },
      "fontWeight": {
        "heading": {
          "$type": "fontWeight",
          "$value": "bold"
        },
        "body": {
          "$type": "fontWeight",
          "$value": "normal"
        },
        "caption": {
          "$type": "fontWeight",
          "$value": "normal"
        }
      }
    },
    "color": {
      "primary": {
        "$type": "color",
        "$value": "#000000",
        "$description": "主色：纯黑"
      },
      "text": {
        "$type": "color",
        "$value": "#000000"
      },
      "heading": {
        "$type": "color",
        "$value": "#000000"
      },
      "link": {
        "$type": "color",
        "$value": "#0000EE"
      },
      "tableHeaderBg": {
        "$type": "color",
        "$value": "#f0f0f0",
        "$description": "三线表表头背景"
      },
      "tableBorder": {
        "$type": "color",
        "$value": "#000000",
        "$description": "三线表线条"
      },
      "background": {
        "$type": "color",
        "$value": "#ffffff"
      }
    },
    "spacing": {
      "paragraph": {
        "$type": "dimension",
        "$value": "0.5em"
      },
      "paragraphAfter": {
        "$type": "dimension",
        "$value": "0.5em"
      },
      "indent": {
        "$type": "dimension",
        "$value": "2em",
        "$description": "首行缩进两字"
      },
      "sectionGap": {
        "$type": "dimension",
        "$value": "1.5em"
      },
      "abstractIndent": {
        "$type": "dimension",
        "$value": "3em",
        "$description": "摘要左右缩进"
      }
    },
    "layout": {
      "marginTop": {
        "$type": "dimension",
        "$value": "3.0cm"
      },
      "marginBottom": {
        "$type": "dimension",
        "$value": "2.5cm"
      },
      "marginLeft": {
        "$type": "dimension",
        "$value": "3.0cm"
      },
      "marginRight": {
        "$type": "dimension",
        "$value": "2.5cm"
      },
      "pageSize": {
        "$type": "string",
        "$value": "A4"
      },
      "columnCount": {
        "$type": "number",
        "$value": 1,
        "$description": "单栏排版（可选双栏）"
      }
    },
    "table": {
      "style": {
        "$type": "string",
        "$value": "three-line",
        "$description": "三线表"
      },
      "borderTopWidth": {
        "$type": "dimension",
        "$value": "1.5pt"
      },
      "borderHeaderWidth": {
        "$type": "dimension",
        "$value": "0.75pt"
      },
      "borderBottomWidth": {
        "$type": "dimension",
        "$value": "1.5pt"
      }
    },
    "numbering": {
      "headingStyle": {
        "$type": "string",
        "$value": "hierarchical",
        "$description": "1 / 1.1 / 1.1.1 层级编号"
      },
      "figurePrefix": {
        "$type": "string",
        "$value": "图",
        "$description": "图编号前缀"
      },
      "tablePrefix": {
        "$type": "string",
        "$value": "表",
        "$description": "表编号前缀"
      },
      "equationBrackets": {
        "$type": "string",
        "$value": "parentheses",
        "$description": "公式编号用圆括号"
      }
    }
  },
  "typography_rules": "../tokens/rules/gb-t-7713-academic.md",
  "css_variables": {
    "--typography-fontFamily-heading": "黑体, SimHei",
    "--typography-fontFamily-body": "宋体, SimSun",
    "--typography-fontFamily-bodyLatin": "Times New Roman, serif",
    "--typography-fontFamily-caption": "宋体, SimSun",
    "--typography-fontFamily-code": "Courier New, Consolas, monospace",
    "--typography-fontSize-title": "18pt",
    "--typography-fontSize-h1": "15pt",
    "--typography-fontSize-h2": "14pt",
    "--typography-fontSize-h3": "12pt",
    "--typography-fontSize-body": "12pt",
    "--typography-fontSize-abstract": "11pt",
    "--typography-fontSize-caption": "10.5pt",
    "--typography-fontSize-footnote": "9pt",
    "--typography-lineHeight-body": "1.5",
    "--typography-lineHeight-abstract": "1.25",
    "--typography-lineHeight-heading": "1.5",
    "--typography-fontWeight-heading": "bold",
    "--typography-fontWeight-body": "normal",
    "--typography-fontWeight-caption": "normal",
    "--color-primary": "#000000",
    "--color-text": "#000000",
    "--color-heading": "#000000",
    "--color-link": "#0000EE",
    "--color-tableHeaderBg": "#f0f0f0",
    "--color-tableBorder": "#000000",
    "--color-background": "#ffffff",
    "--spacing-paragraph": "0.5em",
    "--spacing-paragraphAfter": "0.5em",
    "--spacing-indent": "2em",
    "--spacing-sectionGap": "1.5em",
    "--spacing-abstractIndent": "3em",
    "--layout-marginTop": "3.0cm",
    "--layout-marginBottom": "2.5cm",
    "--layout-marginLeft": "3.0cm",
    "--layout-marginRight": "2.5cm",
    "--layout-pageSize": "A4",
    "--layout-columnCount": "1"
  }
}
