{
  "$name": "business-modern",
  "$description": "现代商务报告主题。专业配色，清晰层级，数据可视化友好色系，适合 PPT 文档和商业分析报告。",
  "typography": {
    "fontFamily": {
      "heading": { "$type": "fontFamily", "$value": "微软雅黑, Microsoft YaHei, PingFang SC" },
      "body": { "$type": "fontFamily", "$value": "微软雅黑, Microsoft YaHei, PingFang SC" },
      "bodyLatin": { "$type": "fontFamily", "$value": "Calibri, Helvetica Neue, sans-serif" },
      "data": { "$type": "fontFamily", "$value": "DIN Next, Arial, sans-serif", "$description": "数据展示字体" },
      "code": { "$type": "fontFamily", "$value": "Consolas, Source Code Pro, monospace" }
    },
    "fontSize": {
      "title": { "$type": "dimension", "$value": "28pt", "$description": "报告主标题" },
      "subtitle": { "$type": "dimension", "$value": "18pt" },
      "h1": { "$type": "dimension", "$value": "20pt" },
      "coverTitle": { "$type": "dimension", "$value": "22pt", "$description": "封面主标题（新增）" },
      "coverCategory": { "$type": "dimension", "$value": "14pt", "$description": "封面分类（新增）" },
      "sectionHeader": { "$type": "dimension", "$value": "13pt", "$description": "章节标题 深底白字（新增）" },
      "h2": { "$type": "dimension", "$value": "11pt", "$description": "小节（原 16pt）" },
      "h3": { "$type": "dimension", "$value": "10pt", "$description": "子小节（原 14pt）" },
      "body": { "$type": "dimension", "$value": "9pt", "$description": "正文（原 11pt）" },
      "small": { "$type": "dimension", "$value": "8pt", "$description": "小字 表格/注（新增）" },
      "tiny": { "$type": "dimension", "$value": "7pt", "$description": "注释（新增）" },
      "caption": { "$type": "dimension", "$value": "9pt" },
      "dataLabel": { "$type": "dimension", "$value": "10pt" }
    },
    "lineHeight": {
      "title": { "$type": "number", "$value": 1.3 },
      "body": { "$type": "number", "$value": 1.6 },
      "compact": { "$type": "number", "$value": 1.2 }
    },
    "fontWeight": {
      "heading": { "$type": "fontWeight", "$value": "600" },
      "body": { "$type": "fontWeight", "$value": "400" },
      "emphasis": { "$type": "fontWeight", "$value": "500" }
    }
  },
  "color": {
    "primary": { "$type": "color", "$value": "#1565C0", "$description": "主品牌蓝" },
    "secondary": { "$type": "color", "$value": "#0288D1", "$description": "辅助蓝" },
    "accent": { "$type": "color", "$value": "#00897B", "$description": "强调色（品牌绿）" },
    "text": { "$type": "color", "$value": "#212121" },
    "textSecondary": { "$type": "color", "$value": "#616161" },
    "heading": { "$type": "color", "$value": "#1A237E" },
    "divider": { "$type": "color", "$value": "#E0E0E0" },
    "background": { "$type": "color", "$value": "#FFFFFF" },
    "surface": { "$type": "color", "$value": "#F5F7FA", "$description": "卡片/侧边栏背景" },
    "dataViz": {
      "series1": { "$type": "color", "$value": "#1565C0" },
      "series2": { "$type": "color", "$value": "#00897B" },
      "series3": { "$type": "color", "$value": "#F9A825" },
      "series4": { "$type": "color", "$value": "#E53935" },
      "series5": { "$type": "color", "$value": "#7B1FA2" },
      "series6": { "$type": "color", "$value": "#0288D1" }
    }
  },
  "spacing": {
    "paragraph": { "$type": "dimension", "$value": "0.75em" },
    "paragraphAfter": { "$type": "dimension", "$value": "0.75em" },
    "indent": { "$type": "dimension", "$value": "0em", "$description": "商务文档不首行缩进" },
    "sectionGap": { "$type": "dimension", "$value": "2.5em" },
    "cardPadding": { "$type": "dimension", "$value": "1.5em" }
  },
  "layout": {
    "marginTop": { "$type": "dimension", "$value": "2.5cm" },
    "marginBottom": { "$type": "dimension", "$value": "2.0cm" },
    "marginLeft": { "$type": "dimension", "$value": "2.5cm" },
    "marginRight": { "$type": "dimension", "$value": "2.5cm" },
    "pageSize": { "$type": "string", "$value": "A4" },
    "maxContentWidth": { "$type": "dimension", "$value": "160mm" }
  },
  "decoration": {
    "headingBorderLeft": { "$type": "boolean", "$value": true, "$description": "标题左侧彩色边框" },
    "headingBorderWidth": { "$type": "dimension", "$value": "4px" },
    "cardShadow": { "$type": "string", "$value": "0 2px 8px rgba(0,0,0,0.08)" },
    "dividerStyle": { "$type": "string", "$value": "solid" }
  }
}
