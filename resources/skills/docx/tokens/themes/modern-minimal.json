{
  "$name": "modern-minimal",
  "$description": "极简默认主题。清晰层级，适当间距，通用场景兜底方案，适合任何未明确场景的文档。",
  "typography": {
    "fontFamily": {
      "heading": { "$type": "fontFamily", "$value": "PingFang SC, 苹方-简, 微软雅黑, sans-serif" },
      "body": { "$type": "fontFamily", "$value": "PingFang SC, 苹方-简, 微软雅黑, sans-serif" },
      "bodyLatin": { "$type": "fontFamily", "$value": "Inter, Helvetica Neue, Arial, sans-serif" },
      "code": { "$type": "fontFamily", "$value": "JetBrains Mono, Fira Code, Consolas, monospace" }
    },
    "fontSize": {
      "title": { "$type": "dimension", "$value": "24pt" },
      "h1": { "$type": "dimension", "$value": "18pt" },
      "h2": { "$type": "dimension", "$value": "15pt" },
      "h3": { "$type": "dimension", "$value": "13pt" },
      "body": { "$type": "dimension", "$value": "11pt" },
      "small": { "$type": "dimension", "$value": "9pt" },
      "caption": { "$type": "dimension", "$value": "9pt" }
    },
    "lineHeight": {
      "title": { "$type": "number", "$value": 1.4 },
      "body": { "$type": "number", "$value": 1.7, "$description": "宽松易读" },
      "heading": { "$type": "number", "$value": 1.3 }
    },
    "fontWeight": {
      "heading": { "$type": "fontWeight", "$value": "600" },
      "body": { "$type": "fontWeight", "$value": "400" }
    }
  },
  "color": {
    "primary": { "$type": "color", "$value": "#2563EB" },
    "text": { "$type": "color", "$value": "#111827" },
    "textSecondary": { "$type": "color", "$value": "#6B7280" },
    "heading": { "$type": "color", "$value": "#111827" },
    "border": { "$type": "color", "$value": "#E5E7EB" },
    "divider": { "$type": "color", "$value": "#F3F4F6" },
    "background": { "$type": "color", "$value": "#FFFFFF" },
    "codeBackground": { "$type": "color", "$value": "#F9FAFB" },
    "highlight": { "$type": "color", "$value": "#FEF3C7" }
  },
  "spacing": {
    "paragraph": { "$type": "dimension", "$value": "0.5em" },
    "paragraphAfter": { "$type": "dimension", "$value": "0.5em" },
    "indent": { "$type": "dimension", "$value": "0em" },
    "sectionGap": { "$type": "dimension", "$value": "2em" },
    "listItemGap": { "$type": "dimension", "$value": "0.4em" }
  },
  "layout": {
    "marginTop": { "$type": "dimension", "$value": "2.5cm" },
    "marginBottom": { "$type": "dimension", "$value": "2.0cm" },
    "marginLeft": { "$type": "dimension", "$value": "2.5cm" },
    "marginRight": { "$type": "dimension", "$value": "2.5cm" },
    "pageSize": { "$type": "string", "$value": "A4" },
    "maxContentWidth": { "$type": "dimension", "$value": "165mm" }
  }
}
