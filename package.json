{
  "name": "kamibuddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "办公 AI Agent 桌面端（基于 pi agent harness）",
  "author": "嘉立创",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "node scripts/run-electron.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/run-electron.mjs preview",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "fetch:node": "node scripts/fetch-node.mjs",
    "fetch:gitbash": "node scripts/fetch-gitbash.mjs",
    "dist:dir": "node scripts/fetch-uv.mjs && node scripts/pack.mjs --dir",
    "dist": "node scripts/fetch-uv.mjs && node scripts/pack.mjs",
    "smoke:sdk": "tsx scripts/smoke-pi-sdk.ts",
    "smoke:session": "tsx scripts/smoke-session.ts",
    "smoke:session-branch": "tsx scripts/smoke-session-branch.ts",
    "smoke:permission": "tsx scripts/smoke-permission-gate.ts",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.ts",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:mcp": "tsx scripts/smoke-mcp-connector.ts",
    "smoke:mcp-activation": "tsx scripts/smoke-mcp-activation.ts",
    "smoke:docx": "tsx scripts/smoke-docx.ts",
    "smoke:docx-roundtrip": "tsx scripts/smoke-docx-roundtrip.ts",
    "probe:prompt-cache": "tsx scripts/probe-prompt-cache.ts",
    "check:deps": "tsx scripts/check-dependency-rules.ts",
    "check:tokens": "tsx scripts/check-design-tokens.ts",
    "check:model-experience": "tsx scripts/check-model-experience.ts",
    "check:invariants": "tsx scripts/check-module-invariants.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:deps && npm run check:tokens && npm run check:model-experience && npm run check:invariants",
    "test": "vitest run"
  },
  "dependencies": {
    "@corbe30/fortune-excel": "^2.3.3",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fortune-sheet/react": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "docx-preview": "^0.4.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "3.10.2",
    "koffi": "3.3.0",
    "linkedom": "^0.18.13",
    "monaco-editor": "^0.56.0",
    "officeparser": "4.2.0",
    "pdfjs-dist": "6.3.289",
    "pptx-preview": "^1.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-pdf": "10.5.0",
    "remark-gfm": "4.0.1",
    "turndown": "^7.2.4",
    "typebox": "^1.3.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "electron-builder": "^26.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-vite": "5.0.0",
    "pdf-lib": "1.17.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
