# Dependencies
node_modules/

# Build and packaging output
out/
dist/
release/
*.tsbuildinfo

# Test and tooling output
coverage/
.cache/
.turbo/
.vite/

# Runtime files and logs
*.log
logs/
*.pid
*.seed

# Local configuration and secrets
.env
.env.*
!.env.example

# Local reference clones; source is not part of the application artifact
开源项目/

# WorkBuddy 完整解包素材（~1.2GB，本地调研用；入库的是精选子集 docs/WorkBuddy-reference/）
docs/WorkBuddy/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Claude 系会话的本地产物（个人设置与会话工件，不入库）
.claude/

# uv.exe 是 fetch:uv 的拉取产物（或运维手工放置），不入库
resources/bin/

# 托管运行时的随包载荷（fetch:node / fetch:gitbash 的拉取与解包产物，几百 MB），不入库；
# 构建安装包时它必须在位（extraResources 从磁盘收集，与 gitignore 无关）。
resources/runtimes/payload/
