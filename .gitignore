# Dependencies
node_modules/

# Build and packaging output
out/
dist/
release/
*.tsbuildinfo

# Test and tooling output
coverage/
.cache/
.turbo/
.vite/

# Runtime files and logs
*.log
logs/
*.pid
*.seed

# Local configuration and secrets
.env
.env.*
!.env.example

# Local reference clones; source is not part of the application artifact
开源项目/

# WorkBuddy 完整解包素材（~1.2GB，本地调研用；入库的是精选子集 docs/WorkBuddy-reference/）
docs/WorkBuddy/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Claude 系会话的本地产物（个人设置与会话工件，不入库）
.claude/

# uv.exe 是 fetch:uv 的拉取产物（或运维手工放置），不入库
resources/bin/

# 托管运行时的构建期载荷与下载缓存（fetch:node / fetch:gitbash 的产物，几百 MB），不入库。
# 2026-09-18 起这两个脚本**已不在默认构建链上**（运行时改为纯按需联网下载），
# payload/ 也不再进安装包（electron-builder.yml 的 extraResources 排除）；
# 保留忽略规则是为了将来企业预置/离线包还要用这两个脚本时不会误提交。
resources/runtimes/payload/
resources/runtimes/.cache/
